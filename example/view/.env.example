# 前端访问后端的地址模板。复制为 .env 后按需修改：
#   cp .env.example .env
# .env 已被 example/.gitignore 忽略，不要提交本地版本。
#
# 这两个值要与 example/application.yml 的 web.server.port 保持一致。
# 改完需重启 vite dev server 才生效。

# 后端 HTTP 地址：vite dev server 代理 /api 的目标
VITE_API_BASE=http://localhost:19008

# 后端 WebSocket 地址：前端直连 /ws（见 ChatRuntimeProvider）
VITE_WS_BASE=ws://localhost:19008
